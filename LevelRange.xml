<?xml-stylesheet type="text/xsl" href="/css/wowui.xsl"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

  <Frame name="LevelRangeFrame" parent="UIParent" hidden="true">
    <Scripts>
      <OnLoad>
        LevelRange_OnLoad();
      </OnLoad>
      <OnEvent>
        LevelRange_OnEvent(event);
      </OnEvent>
    </Scripts>
  </Frame>

  <GameTooltip name="LevelRangeTooltip" parent="WorldMapFrame" hidden="true"
               frameStrata="TOOLTIP" inherits="GameTooltipTemplate">
    <Scripts>
      <OnLoad>
          this:SetBackdropBorderColor(
              TOOLTIP_DEFAULT_COLOR.r,
              TOOLTIP_DEFAULT_COLOR.g,
              TOOLTIP_DEFAULT_COLOR.b,
              0
          );
          this:SetBackdropColor(
              TOOLTIP_DEFAULT_BACKGROUND_COLOR.r,
              TOOLTIP_DEFAULT_BACKGROUND_COLOR.g,
              TOOLTIP_DEFAULT_BACKGROUND_COLOR.b,
              0
          );
      </OnLoad>
    </Scripts>
  </GameTooltip>

  <CheckButton name="LevelRangeOptionsCheckButtonTemplate"
               inherits="UICheckButtonTemplate" virtual="true">
    <Scripts>
      <OnClick>
        if (this:GetChecked()) then
            PlaySound("igMainMenuOptionCheckBoxOff");
        else
            PlaySound("igMainMenuOptionCheckBoxOn");
        end
        LevelRangeOptionsCheckButton_OnClick();
      </OnClick>
      <OnEnter>
        if (this.tooltipText) then
            GameTooltip_AddNewbieTip(this.tooltipText, 1, 1, 1);
        end
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide();
      </OnLeave>
    </Scripts>
  </CheckButton>

  <Frame name="LevelRangeOptionsFrame" toplevel="true" frameStrata="DIALOG"
         movable="true" enableMouse="true" hidden="true" parent="UIParent"
         enableKeyboard="true">
    <Size>
      <AbsDimension x="350" y="290"/>
    </Size>
    <Anchors>
      <Anchor point="CENTER"/>
    </Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
              edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets>
        <AbsInset left="11" right="12" top="12" bottom="11"/>
      </BackgroundInsets>
      <TileSize>
        <AbsValue val="32"/>
      </TileSize>
      <EdgeSize>
        <AbsValue val="32"/>
      </EdgeSize>
    </Backdrop>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="LevelRangeOptionsFrameHeader"
                 file="Interface\DialogFrame\UI-DialogBox-Header">
          <Size>
            <AbsDimension x="300" y="64"/>
          </Size>
          <Anchors>
            <Anchor point="TOP">
              <Offset>
                <AbsDimension x="0" y="12"/>
              </Offset>
            </Anchor>
          </Anchors>
        </Texture>
        <FontString inherits="GameFontNormal" name="LevelRangeOptionsFrameTitle">
          <Anchors>
            <Anchor point="TOP" relativeTo="LevelRangeOptionsFrameHeader">
              <Offset>
                <AbsDimension x="0" y="-14"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>

      <CheckButton name="$parentOpt1"
                   inherits="LevelRangeOptionsCheckButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="25" y="-25"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

      <CheckButton name="$parentOpt2"
                   inherits="LevelRangeOptionsCheckButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="45" y="-55"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

      <CheckButton name="$parentOpt3"
                   inherits="LevelRangeOptionsCheckButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="45" y="-85"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

      <CheckButton name="$parentOpt4"
                   inherits="LevelRangeOptionsCheckButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="45" y="-115"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

      <CheckButton name="$parentOpt5"
                   inherits="LevelRangeOptionsCheckButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="45" y="-145"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

      <Slider name="$parentFontSizeSlider" inherits="OptionsSliderTemplate">
        <Size>
          <AbsDimension x="170" y="16"/>
        </Size>
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="47" y="-185"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>
            this:SetMinMaxValues(8, 24);
            this:SetValueStep(1);
            getglobal(this:GetName() .. "Low"):SetText("8");
            getglobal(this:GetName() .. "High"):SetText("24");
          </OnLoad>
          <OnValueChanged>
            LevelRangeOptionsFrameFontSizeSlider_OnValueChanged();
          </OnValueChanged>
        </Scripts>
      </Slider>

      <EditBox name="$parentFontSizeEditBox" inherits="InputBoxTemplate" letters="2" autoFocus="false">
        <Size>
          <AbsDimension x="30" y="20"/>
        </Size>
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="232" y="-185"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnEnterPressed>
            LevelRangeOptionsFrameFontSizeEditBox_OnEnterPressed();
          </OnEnterPressed>
          <OnEscapePressed>
            this:ClearFocus();
          </OnEscapePressed>
        </Scripts>
      </EditBox>

      <Button name="LevelRangeOptionsFrameCloseButton"
              inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset>
              <AbsDimension x="-4" y="-4"/>
            </Offset>
          </Anchor>
        </Anchors>
      </Button>
    </Frames>
    <Scripts>
      <OnShow>
        LevelRangeOptionsFrame_OnShow();
      </OnShow>
    </Scripts>
  </Frame>
</Ui>